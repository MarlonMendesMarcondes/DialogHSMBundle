{#
  Construtor guiado de template: número, template (lista do número ou digitado), idioma, um campo
  por variável e prévia no formato do WhatsApp. Usado pelo tema das ações de campanha novas e pela
  tela da Mensagem WhatsApp (Marketing Messages).

  Variáveis: builderId, numberField, nameField, languageField, paramsField (FormViews).

  Os valores vão para paramsField em JSON; quem guarda e converte no payload é o servidor
  (ver Service\TemplatePayload). Cada variável do body tem origem — valor fixo, campo do contato ou
  campo de Custom Object (só com o fork do CustomObjectsBundle) — e cálculo para data e número. O script roda inline: no construtor de campanha o formulário
  chega por AJAX no modal e o jQuery executa scripts do conteúdo inserido.
#}
        {% set config = {
        url: path('mautic_dialoghsm_number_templates', {objectId: 0}),
        ids: {
            number: numberField.vars.id,
            name: nameField.vars.id,
            language: languageField.vars.id,
            params: paramsField.vars.id,
        },
        sources: dialoghsm_variable_sources(),
        i18n: {
            chooseNumber: 'dialoghsm.campaign.template.js.choose_number'|trans,
            loading: 'dialoghsm.campaign.template.js.loading'|trans,
            unavailable: 'dialoghsm.campaign.template.js.unavailable'|trans,
            loaded: 'dialoghsm.campaign.template.js.loaded'|trans,
            placeholder: 'dialoghsm.campaign.template.js.placeholder'|trans,
            notInList: 'dialoghsm.campaign.template.js.not_in_list'|trans,
            notApproved: 'dialoghsm.campaign.template.js.not_approved'|trans,
            headerMedia: 'dialoghsm.campaign.template.js.header_media'|trans,
            headerMediaHelp: 'dialoghsm.campaign.template.js.header_media_help'|trans,
            headerTextVars: 'dialoghsm.campaign.template.js.header_text_vars'|trans,
            headerLocation: 'dialoghsm.campaign.template.js.header_location'|trans,
            variable: 'dialoghsm.campaign.template.js.variable'|trans,
            variableHelp: 'dialoghsm.campaign.template.js.variable_help'|trans,
            namedVars: 'dialoghsm.campaign.template.js.named_vars'|trans,
            button: 'dialoghsm.campaign.template.js.button'|trans,
            buttonUrlHelp: 'dialoghsm.campaign.template.js.button_url_help'|trans,
            buttonUnknown: 'dialoghsm.campaign.template.js.button_unknown'|trans,
            carousel: 'dialoghsm.campaign.template.js.carousel'|trans,
            noVariables: 'dialoghsm.campaign.template.js.no_variables'|trans,
            addVariable: 'dialoghsm.campaign.template.js.add_variable'|trans,
            remove: 'dialoghsm.campaign.template.js.remove'|trans,
            preview: 'dialoghsm.campaign.template.js.preview'|trans,
            refresh: 'dialoghsm.campaign.template.js.refresh'|trans,
            sourceStatic: 'dialoghsm.campaign.template.js.source.static'|trans,
            sourceField: 'dialoghsm.campaign.template.js.source.field'|trans,
            sourceCustomObject: 'dialoghsm.campaign.template.js.source.custom_object'|trans,
            chooseField: 'dialoghsm.campaign.template.js.choose_field'|trans,
            chooseObject: 'dialoghsm.campaign.template.js.choose_object'|trans,
            calculation: 'dialoghsm.campaign.template.js.calculation'|trans,
            calculationDate: 'dialoghsm.campaign.template.js.calculation_date'|trans,
            calculationNumber: 'dialoghsm.campaign.template.js.calculation_number'|trans,
            customObjectUnavailable: 'dialoghsm.campaign.template.js.custom_object_unavailable'|trans,
        },
    } %}

    <div id="{{ builderId }}" class="dialoghsm-template-builder" data-config="{{ config|json_encode|e('html_attr') }}">
        {{ form_row(numberField) }}

        <div class="form-group" data-role="select-row" style="display:none;">
            <label class="control-label" for="{{ builderId }}_select">{{ 'dialoghsm.campaign.template.name'|trans }}</label>
            <div class="input-group">
                <select id="{{ builderId }}_select" class="form-control" data-role="template-select"></select>
                <span class="input-group-btn">
                    <button type="button" class="btn btn-ghost" data-role="refresh" title="{{ 'dialoghsm.campaign.template.js.refresh'|trans }}">
                        <i class="ri-refresh-line"></i>
                    </button>
                </span>
            </div>
        </div>

        <div class="row" data-role="manual-row">
            <div class="col-sm-8">{{ form_row(nameField) }}</div>
            <div class="col-sm-4">{{ form_row(languageField) }}</div>
        </div>

        <p class="help-block" data-role="status"></p>

        <div data-role="fields"></div>

        {# Prévia no formato do WhatsApp (componente _wa_preview, incluído acima do script). #}
        <div data-role="preview-panel"></div>

        {{ form_widget(paramsField) }}

    </div>

    {% include '@DialogHSM/FormTheme/_wa_preview.html.twig' %}

    <script>
    (function () {
        var root = document.getElementById({{ builderId|json_encode|raw }});
        if (!root || root.getAttribute('data-ready')) {
            return;
        }
        root.setAttribute('data-ready', '1');

        var cfg      = JSON.parse(root.getAttribute('data-config'));
        var t        = cfg.i18n;
        var numberEl = document.getElementById(cfg.ids.number);
        var nameEl   = document.getElementById(cfg.ids.name);
        var langEl   = document.getElementById(cfg.ids.language);
        var paramsEl = document.getElementById(cfg.ids.params);
        var select   = root.querySelector('[data-role="template-select"]');
        var selRow   = root.querySelector('[data-role="select-row"]');
        var manRow   = root.querySelector('[data-role="manual-row"]');
        var statusEl = root.querySelector('[data-role="status"]');
        var fields   = root.querySelector('[data-role="fields"]');
        var prevPane = root.querySelector('[data-role="preview-panel"]');

        // Tipo do botão no template → sub_type do envio; só estes têm parâmetro conhecido.
        var BUTTON_SUBTYPES = {URL: 'url', COPY_CODE: 'copy_code'};
        var MEDIA = {IMAGE: '.jpg, .jpeg, .png', VIDEO: '.mp4', DOCUMENT: '.pdf'};

        var templates = [];
        var params    = readParams();

        function readParams() {
            try {
                var p = JSON.parse(paramsEl.value || '{}');
                return {
                    body: Array.isArray(p.body) ? p.body : [],
                    header: typeof p.header === 'string' ? p.header : '',
                    buttons: p.buttons && typeof p.buttons === 'object' ? p.buttons : {}
                };
            } catch (e) {
                return {body: [], header: '', buttons: {}};
            }
        }

        function sync() {
            paramsEl.value = JSON.stringify(params);
            renderPreview();
        }

        // O Mautic aplica o "chosen" a todo select do modal assim que ele abre — antes de a lista
        // chegar. Sem avisar o chosen, as opções novas não aparecem (o dropdown fica vazio).
        function refreshChosen() {
            if (window.mQuery && mQuery(select).data('chosen')) {
                mQuery(select).trigger('chosen:updated');
            }
        }

        function setStatus(text, warn) {
            statusEl.textContent = text || '';
            statusEl.className = 'help-block' + (warn ? ' text-warning' : '');
        }

        function el(tag, attrs, text) {
            var node = document.createElement(tag);
            Object.keys(attrs || {}).forEach(function (k) { node.setAttribute(k, attrs[k]); });
            if (text !== undefined && text !== null) { node.textContent = text; }
            return node;
        }

        function input(label, value, help, onInput, placeholder) {
            var group = el('div', {'class': 'form-group'});
            group.appendChild(el('label', {'class': 'control-label'}, label));
            var field = el('input', {type: 'text', 'class': 'form-control', placeholder: placeholder || ''});
            field.value = value || '';
            field.addEventListener('input', function () { onInput(field.value); sync(); });
            group.appendChild(field);
            if (help) { group.appendChild(el('span', {'class': 'help-block'}, help)); }
            return group;
        }

        function warning(text) {
            return el('div', {'class': 'alert alert-warning', style: 'padding:8px 12px;'}, text);
        }

        function fmt(text, values) {
            return text.replace(/%(\w+)%/g, function (m, k) { return values[k] !== undefined ? values[k] : m; });
        }

        function current() {
            var key = nameEl.value + '|' + (langEl.value || 'pt_BR');
            for (var i = 0; i < templates.length; i++) {
                if (templates[i].name + '|' + templates[i].language === key) { return templates[i]; }
            }
            return null;
        }

        // ── modo lista ──────────────────────────────────────────────────────
        function fillSelect() {
            select.innerHTML = '';
            select.appendChild(el('option', {value: ''}, t.placeholder));

            var selected = current();
            templates.forEach(function (tpl) {
                var label = tpl.name + ' (' + tpl.language + ')' + (tpl.category ? ' · ' + tpl.category : '');
                if (!tpl.approved) { label += ' — ' + fmt(t.notApproved, {status: tpl.status}); }
                var opt = el('option', {value: tpl.name + '|' + tpl.language}, label);
                if (!tpl.approved) { opt.disabled = true; }
                if (selected === tpl) { opt.selected = true; }
                select.appendChild(opt);
            });

            // Template salvo na ação que não está na lista (apagado, renomeado, outro número):
            // fica visível e selecionado, com aviso — não some sem o usuário perceber.
            if (!selected && nameEl.value) {
                var missing = el('option', {value: nameEl.value + '|' + (langEl.value || 'pt_BR')}, nameEl.value + ' (' + (langEl.value || 'pt_BR') + ') — ' + t.notInList);
                missing.selected = true;
                select.appendChild(missing);
                setStatus(t.notInList, true);
            } else if (manRow.querySelector('.has-error')) {
                // Formulário devolvido pelo servidor sem template: o erro está no campo oculto.
                setStatus(t.placeholder, true);
            } else {
                setStatus(fmt(t.loaded, {count: templates.length}));
            }

            selRow.style.display = '';
            manRow.style.display = 'none';
            refreshChosen();
            renderTemplate(selected);
        }

        function onTemplateChange() {
            var parts = select.value.split('|');
            nameEl.value = parts[0] || '';
            langEl.value = parts[1] || '';
            var tpl = current();
            // Troca de template: valores que não fazem mais sentido não podem ir junto.
            params.header  = tpl && MEDIA[tpl.header.format] ? params.header : '';
            params.buttons = {};
            renderTemplate(tpl);
            setStatus(tpl ? '' : t.notInList, !tpl && !!nameEl.value);
        }

        // O chosen dispara a troca como evento jQuery, que um listener nativo não recebe.
        if (window.mQuery) {
            mQuery(select).on('change', onTemplateChange);
        } else {
            select.addEventListener('change', onTemplateChange);
        }

        // ── variável: origem (valor fixo, campo do contato, Custom Object) + cálculo ──
        // Mesmo modelo do editor de HSM do N8nDispatchBundle. A variável é guardada como objeto
        // {source, value | field | customObject + customObjectField, dateOffsetDays}; texto (formato
        // antigo) é lido como valor fixo. O servidor resolve cada origem no envio.
        var SOURCES    = cfg.sources || {contactFields: [], customObjects: null};
        var CALC_TYPES = {date: 'date', datetime: 'date', number: 'number', int: 'number', decimal: 'number'};

        function normalizeVariable(value) {
            if (value && typeof value === 'object') { return value; }
            return {source: 'static', value: null === value || undefined === value ? '' : String(value)};
        }

        function findBy(list, alias) {
            for (var i = 0; i < (list || []).length; i++) {
                if (list[i].alias === alias) { return list[i]; }
            }
            return null;
        }

        function selectBox(options, value, placeholder) {
            var node = el('select', {'class': 'form-control'});
            if (placeholder) { node.appendChild(el('option', {value: ''}, placeholder)); }
            options.forEach(function (o) {
                var opt = el('option', {value: o.value}, o.label);
                if (o.value === value) { opt.selected = true; }
                node.appendChild(opt);
            });
            if (undefined !== value && null !== value) { node.value = value; }
            return node;
        }

        function fieldOptions(fields) {
            return (fields || []).map(function (f) { return {value: f.alias, label: f.label + ' (' + f.alias + ')'}; });
        }

        function calculationBox(variable, type) {
            var kind = CALC_TYPES[type];
            if (!kind) {
                delete variable.dateOffsetDays;
                return null;
            }
            var wrap  = el('div', {style: 'margin-top:6px;'});
            var group = el('div', {'class': 'input-group'});
            group.appendChild(el('span', {'class': 'input-group-addon'}, t.calculation));
            var field = el('input', {type: 'text', 'class': 'form-control', placeholder: '0', inputmode: 'decimal'});
            field.value = variable.dateOffsetDays || '';
            field.addEventListener('input', function () { variable.dateOffsetDays = field.value; sync(); });
            group.appendChild(field);
            wrap.appendChild(group);
            wrap.appendChild(el('span', {'class': 'help-block'}, 'date' === kind ? t.calculationDate : t.calculationNumber));
            return wrap;
        }

        function variableEditor(idx, help, extra) {
            params.body[idx] = normalizeVariable(params.body[idx]);

            var group = el('div', {'class': 'form-group'});
            group.appendChild(el('label', {'class': 'control-label'}, fmt(t.variable, {n: idx + 1})));
            var row   = el('div', {'class': 'row'});
            var left  = el('div', {'class': 'col-sm-4'});
            var right = el('div', {'class': 'col-sm-8'});
            row.appendChild(left);
            row.appendChild(right);
            group.appendChild(row);

            var saved   = params.body[idx];
            var choices = [{value: 'static', label: t.sourceStatic}, {value: 'field', label: t.sourceField}];
            if (SOURCES.customObjects || 'custom_object' === saved.source) {
                choices.push({value: 'custom_object', label: t.sourceCustomObject});
            }
            var source = selectBox(choices, saved.source || 'static');
            left.appendChild(source);
            source.addEventListener('change', function () {
                params.body[idx] = 'static' === source.value ? {source: 'static', value: ''} : {source: source.value};
                drawRight();
                sync();
            });

            function drawRight() {
                var variable = params.body[idx];
                right.innerHTML = '';

                if ('field' === variable.source) {
                    var fieldSel = selectBox(fieldOptions(SOURCES.contactFields), variable.field || '', t.chooseField);
                    var calcSlot = el('div');
                    var drawCalc = function () {
                        calcSlot.innerHTML = '';
                        var f   = findBy(SOURCES.contactFields, variable.field);
                        var box = calculationBox(variable, f ? f.type : '');
                        if (box) { calcSlot.appendChild(box); }
                    };
                    fieldSel.addEventListener('change', function () { variable.field = fieldSel.value; drawCalc(); sync(); });
                    right.appendChild(fieldSel);
                    right.appendChild(calcSlot);
                    drawCalc();
                    return;
                }

                if ('custom_object' === variable.source) {
                    if (!SOURCES.customObjects) {
                        right.appendChild(warning(t.customObjectUnavailable));
                        return;
                    }
                    var objects   = SOURCES.customObjects.map(function (o) { return {value: o.alias, label: o.label}; });
                    var objectSel = selectBox(objects, variable.customObject || '', t.chooseObject);
                    var fieldSlot = el('div', {style: 'margin-top:6px;'});
                    var calcSlot2 = el('div');
                    var drawFields = function () {
                        fieldSlot.innerHTML = '';
                        calcSlot2.innerHTML = '';
                        var object = findBy(SOURCES.customObjects, variable.customObject);
                        if (!object) { return; }
                        var coFieldSel = selectBox(fieldOptions(object.fields), variable.customObjectField || '', t.chooseField);
                        var drawCalc2 = function () {
                            calcSlot2.innerHTML = '';
                            var f   = findBy(object.fields, variable.customObjectField);
                            var box = calculationBox(variable, f ? f.type : '');
                            if (box) { calcSlot2.appendChild(box); }
                        };
                        coFieldSel.addEventListener('change', function () { variable.customObjectField = coFieldSel.value; drawCalc2(); sync(); });
                        fieldSlot.appendChild(coFieldSel);
                        drawCalc2();
                    };
                    objectSel.addEventListener('change', function () {
                        variable.customObject = objectSel.value;
                        delete variable.customObjectField;
                        drawFields();
                        sync();
                    });
                    right.appendChild(objectSel);
                    right.appendChild(fieldSlot);
                    right.appendChild(calcSlot2);
                    drawFields();
                    return;
                }

                var text = el('input', {type: 'text', 'class': 'form-control', placeholder: '{contactfield=firstname}'});
                text.value = variable.value || '';
                text.addEventListener('input', function () { variable.value = text.value; sync(); });
                right.appendChild(text);
            }

            drawRight();
            if (help) { group.appendChild(el('span', {'class': 'help-block'}, help)); }
            if (extra) { group.appendChild(extra); }

            return group;
        }

        // Valor mostrado na prévia: a origem vira um selo (o valor real só existe no envio).
        function previewValue(value) {
            var variable = normalizeVariable(value);
            var amount   = parseFloat(String(variable.dateOffsetDays || '0').replace(',', '.')) || 0;
            var suffix   = 0 !== amount ? ' ' + (amount > 0 ? '+' : '') + amount : '';

            if ('field' === variable.source) {
                var f = findBy(SOURCES.contactFields, variable.field);
                return variable.field ? '{contactfield=' + (f ? f.label : variable.field) + suffix + '}' : '';
            }
            if ('custom_object' === variable.source) {
                var o  = findBy(SOURCES.customObjects, variable.customObject);
                var cf = o ? findBy(o.fields, variable.customObjectField) : null;
                return variable.customObject && variable.customObjectField
                    ? '{contactfield=' + (o ? o.label : variable.customObject) + '.' + (cf ? cf.label : variable.customObjectField) + suffix + '}'
                    : '';
            }

            return variable.value || '';
        }

        function renderTemplate(tpl) {
            fields.innerHTML = '';
            if (!tpl) {
                prevPane.innerHTML = '';
                sync();
                return;
            }

            var fmtHeader = tpl.header.format;
            if (MEDIA[fmtHeader]) {
                fields.appendChild(input(
                    fmt(t.headerMedia, {format: fmtHeader}),
                    params.header,
                    fmt(t.headerMediaHelp, {ext: MEDIA[fmtHeader]}),
                    function (v) { params.header = v; },
                    'https://'
                ));
            } else {
                params.header = '';
                if (fmtHeader === 'TEXT' && tpl.header.vars) { fields.appendChild(warning(t.headerTextVars)); }
                if (fmtHeader === 'LOCATION') { fields.appendChild(warning(t.headerLocation)); }
            }

            if (tpl.body.vars === null) {
                fields.appendChild(warning(t.namedVars));
            } else {
                params.body = params.body.slice(0, tpl.body.vars);
                for (var i = 0; i < tpl.body.vars; i++) {
                    fields.appendChild(variableEditor(i, i === 0 ? t.variableHelp : ''));
                }
                if (tpl.body.vars === 0 && !MEDIA[fmtHeader]) { fields.appendChild(el('p', {'class': 'text-muted'}, t.noVariables)); }
            }

            var keep = {};
            tpl.buttons.forEach(function (b) {
                if (b.vars === null) {
                    fields.appendChild(warning(fmt(t.buttonUnknown, {n: b.index + 1, type: b.type})));
                    return;
                }
                if (!b.vars || !BUTTON_SUBTYPES[b.type]) { return; }
                var prev = params.buttons[b.index] || {};
                keep[b.index] = {type: BUTTON_SUBTYPES[b.type], value: prev.value || ''};
                (function (idx) {
                    fields.appendChild(input(
                        fmt(t.button, {n: idx + 1, type: b.type, text: b.text}),
                        keep[idx].value,
                        b.type === 'URL' ? t.buttonUrlHelp : '',
                        function (v) { params.buttons[idx].value = v; }
                    ));
                })(b.index);
            });
            params.buttons = keep;

            if (tpl.carousel) { fields.appendChild(warning(fmt(t.carousel, {count: tpl.carousel}))); }

            sync();
        }

        // ── prévia (componente DialogHsmPreview, de _wa_preview) ────────────
        function renderPreview() {
            if (window.DialogHsmPreview) {
                var shown = {header: params.header, buttons: params.buttons, body: params.body.map(previewValue)};
                window.DialogHsmPreview.render(prevPane, current(), shown, {title: t.preview});
            }
        }

        // ── modo manual (lista indisponível) ────────────────────────────────
        function manualMode(message) {
            templates = [];
            selRow.style.display = 'none';
            manRow.style.display = '';
            setStatus(message, true);
            prevPane.innerHTML = '';
            renderManual();
        }

        function renderManual() {
            fields.innerHTML = '';
            fields.appendChild(input(fmt(t.headerMedia, {format: ''}).trim(), params.header, fmt(t.headerMediaHelp, {ext: '.jpg, .png, .mp4, .pdf'}), function (v) { params.header = v; }, 'https://'));

            params.body.forEach(function (value, idx) {
                var remove = el('button', {type: 'button', 'class': 'btn btn-ghost btn-xs'}, t.remove);
                remove.addEventListener('click', function () { params.body.splice(idx, 1); renderManual(); sync(); });
                fields.appendChild(variableEditor(idx, '', remove));
            });

            var add = el('button', {type: 'button', 'class': 'btn btn-ghost btn-sm'}, t.addVariable);
            add.addEventListener('click', function () { params.body.push({source: 'static', value: ''}); renderManual(); sync(); });
            fields.appendChild(add);
            sync();
        }

        // ── carga ───────────────────────────────────────────────────────────
        function load(refresh) {
            var id = numberEl ? numberEl.value : '';
            if (!id) {
                selRow.style.display = 'none';
                manRow.style.display = 'none';
                fields.innerHTML = '';
                setStatus(t.chooseNumber);
                return;
            }

            // Carregando: o próprio campo mostra o estado, em vez de um dropdown vazio.
            setStatus(t.loading);
            select.innerHTML = '';
            select.appendChild(el('option', {value: ''}, t.loading));
            selRow.style.display = '';
            manRow.style.display = 'none';
            fields.innerHTML = '';
            refreshChosen();
            // objectId=0 é o padrão da rota, então o path() sai sem ele: o id entra aqui no fim.
            var url = cfg.url.replace(/\/0$/, '') + '/' + encodeURIComponent(id) + (refresh ? '?refresh=1' : '');
            fetch(url, {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest', Accept: 'application/json'}})
                .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
                .then(function (data) {
                    if (!data.available) { manualMode(t.unavailable); return; }
                    templates = data.templates || [];
                    fillSelect();
                })
                .catch(function () { manualMode(t.unavailable); });
        }

        root.querySelector('[data-role="refresh"]').addEventListener('click', function () { load(true); });

        // O seletor de número é um chosen (jQuery): a troca chega como evento jQuery.
        if (numberEl) {
            if (window.mQuery) {
                mQuery(numberEl).on('change', function () { load(false); });
            } else {
                numberEl.addEventListener('change', function () { load(false); });
            }
        }

        load(false);
    })();
    </script>
