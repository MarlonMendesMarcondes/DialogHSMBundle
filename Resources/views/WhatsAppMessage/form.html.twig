{% extends '@MauticCore/FormTheme/form_simple.html.twig' %}

{% block mauticContent %}dialoghsm_message{% endblock %}
{% set isExisting      = entity.getId() %}
{% set translationBase = 'dialoghsm.whatsapp_message' %}
{% set mauticContent   = 'dialoghsm_message' %}

{% block primaryFormContent %}
<div class="row">
    <div class="col-md-8">
        {{ form_row(form.name) }}
    </div>
</div>

{# Mesmo construtor guiado das ações de campanha novas: número, template da lista do número, um
   campo por variável e prévia. Idioma e variáveis são gravados na chave "hsm" do payloadData. #}
<div class="row">
    <div class="col-md-8">
        {% include '@DialogHSM/FormTheme/_template_builder.html.twig' with {
            builderId: 'dialoghsm_whatsapp_message_hsm_builder',
            numberField: form.whatsAppNumber,
            nameField: form.templateName,
            languageField: form.hsm_language,
            paramsField: form.hsm_params,
        } %}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <details>
            <summary style="cursor:pointer;">{{ 'dialoghsm.campaign.template.advanced'|trans }}</summary>
            <p class="help-block">{{ 'dialoghsm.campaign.template.advanced.help'|trans }}</p>
            {{ form_row(form.payloadData) }}
        </details>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.lists) }}
    </div>
</div>
{% endblock %}

{% block rightFormContent %}
{{ form_row(form.isPublished) }}
{{ form_row(form.publishUp) }}
{{ form_row(form.publishDown) }}

<div class="hide">
    {{ form_rest(form) }}
</div>
{% endblock %}
