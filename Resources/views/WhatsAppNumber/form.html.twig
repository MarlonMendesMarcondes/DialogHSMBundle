{% extends '@MauticCore/FormTheme/form_simple.html.twig' %}

{% block mauticContent %}dialoghsm_number{% endblock %}
{% set isExisting      = entity.getId() %}
{% set translationBase = 'dialoghsm.number' %}
{% set mauticContent   = 'dialoghsm_number' %}

{% block primaryFormContent %}
<div class="row">
    <div class="col-md-6">
        {{ form_row(form.name) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.phoneNumber) }}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.apiKey) }}
        {% if entity.id and entity.apiKey is not empty %}
            <p class="help-block" style="margin-top:-10px">
                <span class="label label-success"><i class="ri-shield-keyhole-line"></i> API Key configured</span>
                &nbsp;Leave blank to keep the current key.
            </p>
        {% else %}
            <p class="help-block" style="margin-top:-10px">
                <span class="label label-warning"><i class="ri-key-line"></i> API Key not set</span>
            </p>
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.baseUrl) }}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.queueName) }}
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        {{ form_row(form.batchQueueName) }}
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        {{ form_row(form.clientId) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.channelId) }}
    </div>
</div>

{% if isExisting and entity.clientId is not empty and entity.channelId is not empty %}
<hr>
<div class="panel panel-default">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="ri-wallet-3-line"></i> {{ 'dialoghsm.number.balance.title'|trans }}</h5>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4">
                <p id="balance-current" class="small">
                    {% if entity.balanceUpdatedAt %}
                        <strong style="font-size:18px">{{ entity.balance }} {{ entity.balanceCurrency|upper }}</strong>
                        <br>
                        <span class="text-muted">{{ 'dialoghsm.number.balance.updated_at'|trans }}: {{ entity.balanceUpdatedAt|date('d/m/Y H:i') }}</span>
                    {% else %}
                        <span class="text-muted">{{ 'dialoghsm.number.balance.not_checked'|trans }}</span>
                    {% endif %}
                </p>

                <div id="balance-result" class="alert" style="display:none"></div>

                <button type="button" class="btn btn-primary btn-sm" id="btn-balance-check">
                    <i class="ri-refresh-line"></i> {{ 'dialoghsm.number.balance.check'|trans }}
                </button>
            </div>

            {% if entity.balanceUsageSnapshot is not empty %}
            <div class="col-md-8">
                <p class="small text-muted" style="margin-bottom:4px">{{ 'dialoghsm.number.balance.usage_chart.title'|trans }}</p>
                <div style="height:220px">
                    <canvas id="balance-usage-chart"></canvas>
                </div>
            </div>
            {% endif %}
        </div>

        {% if balanceHistory is defined and balanceHistory|length %}
        <hr style="margin:16px 0 12px">
        <p class="small text-muted" style="margin-bottom:4px">{{ 'dialoghsm.number.balance.history.title'|trans }}</p>
        <div class="row">
            {% for entry in balanceHistory %}
            <div class="col-md-3 col-sm-4 col-xs-6" style="margin-bottom:8px">
                <div class="small">{{ entry.rechargeDate|date('d/m/Y') }}</div>
                <div>
                    {% if entry.rechargeAmount is not null %}
                        <strong>+{{ entry.rechargeAmount }} {{ entry.currency|upper }}</strong>
                    {% else %}
                        —
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
{% endblock %}

{% block rightFormContent %}
{{ form_row(form.isPublished) }}

{% if isExisting and entity.apiKey is not empty %}
<hr>
<div class="panel panel-default">
    <div class="panel-heading">
        <h5 class="panel-title"><i class="ri-webhook-line"></i> {{ 'dialoghsm.number.webhook.title'|trans }}</h5>
    </div>
    <div class="panel-body">
        <p class="small text-muted">{{ 'dialoghsm.number.webhook.description'|trans }}</p>

        <div id="webhook-result" class="alert" style="display:none"></div>

        <div class="btn-group btn-group-sm" style="display:flex; gap:6px; flex-wrap:wrap">
            <button type="button" class="btn btn-default" id="btn-webhook-check" style="color:#212529">
                <i class="ri-search-eye-line"></i> {{ 'dialoghsm.number.webhook.check'|trans }}
            </button>
            <button type="button" class="btn btn-primary" id="btn-webhook-register">
                <i class="ri-link-m"></i> {{ 'dialoghsm.number.webhook.register'|trans }}
            </button>
        </div>
    </div>
</div>
{% endif %}

<div class="hide">
    {{ form_rest(form) }}
</div>

{% if isExisting and entity.apiKey is not empty %}
<script>
(function () {
    var checkUrl    = '{{ path('mautic_dialoghsm_number_webhook_check',    {'objectId': entity.getId()}) }}';
    var registerUrl = '{{ path('mautic_dialoghsm_number_webhook_register', {'objectId': entity.getId()}) }}';
    var resultDiv   = document.getElementById('webhook-result');

    function showResult(html, type) {
        resultDiv.className = 'alert alert-' + type;
        resultDiv.innerHTML = html;
        resultDiv.style.display = 'block';
    }

    function formatCheck(data) {
        if (data.error) {
            return '<strong>Erro:</strong> ' + data.error;
        }
        var html = '<strong>{{ 'dialoghsm.number.webhook.enabled'|trans }}:</strong> ' + (data.enabled ? '✓' : '✗') + '<br>';
        var dests = data.destinations || [];
        if (dests.length === 0) {
            html += '<em>{{ 'dialoghsm.number.webhook.no_destinations'|trans }}</em>';
        } else {
            html += '<strong>{{ 'dialoghsm.number.webhook.destinations'|trans }}:</strong><ul style="margin:4px 0 0 0">';
            dests.forEach(function (d) {
                html += '<li><code>' + d.name + '</code>: <span style="word-break:break-all">' + d.url + '</span></li>';
            });
            html += '</ul>';
        }
        return html;
    }

    document.getElementById('btn-webhook-check').addEventListener('click', function () {
        showResult('<i class="ri-loader-line"></i> ...', 'info');
        mQuery.ajax({ url: checkUrl, method: 'GET', dataType: 'json',
            success: function (d) { showResult(formatCheck(d), d.error ? 'danger' : 'info'); },
            error:   function (x) { showResult('HTTP ' + x.status, 'danger'); }
        });
    });

    document.getElementById('btn-webhook-register').addEventListener('click', function () {
        showResult('<i class="ri-loader-line"></i> ...', 'info');
        mQuery.ajax({ url: registerUrl, method: 'POST', dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (d) {
                if (d.success) {
                    var msg = '✓ <strong>' + d.action + '</strong>';
                    if (d.url) msg += '<br><code>' + d.url + '</code>';
                    showResult(msg, 'success');
                } else {
                    showResult('<strong>Erro [' + d.action + ']:</strong> ' + d.message, 'danger');
                }
            },
            error: function (x) { showResult('HTTP ' + x.status, 'danger'); }
        });
    });
}());
</script>
{% endif %}

{% if isExisting and entity.clientId is not empty and entity.channelId is not empty %}
<script>
(function () {
    var balanceCheckUrl = '{{ path('mautic_dialoghsm_number_balance_check', {'objectId': entity.getId()}) }}';
    var currentEl       = document.getElementById('balance-current');
    var resultDiv       = document.getElementById('balance-result');

    document.getElementById('btn-balance-check').addEventListener('click', function () {
        resultDiv.className = 'alert alert-info';
        resultDiv.innerHTML = '<i class="ri-loader-line"></i> ...';
        resultDiv.style.display = 'block';

        mQuery.ajax({ url: balanceCheckUrl, method: 'POST', dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (d) {
                if (d.success) {
                    var currency = (d.currency || '').toUpperCase();
                    currentEl.innerHTML = '<strong>' + d.balance + ' ' + currency + '</strong><br>'
                        + '<span class="text-muted">{{ 'dialoghsm.number.balance.updated_at'|trans }}: '
                        + new Date(d.balanceUpdatedAt).toLocaleString() + '</span>';
                    resultDiv.style.display = 'none';
                } else {
                    resultDiv.className = 'alert alert-danger';
                    resultDiv.innerHTML = '<strong>Erro:</strong> ' + d.error;
                }
            },
            error: function (x) {
                resultDiv.className = 'alert alert-danger';
                resultDiv.innerHTML = 'HTTP ' + x.status;
            }
        });
    });
}());
</script>
{% endif %}

{% if entity.balanceUsageSnapshot is not empty %}
<script>
(function () {
    var usage = {{ entity.balanceUsageSnapshot|json_encode|raw }};

    var labels = usage.map(function (row) {
        var parts = row.period_date.split('-');
        return parts[1] + '/' + parts[0].slice(2);
    });
    var totals = usage.map(function (row) { return row.total_price; });

    var ctx = document.getElementById('balance-usage-chart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: '{{ 'dialoghsm.number.balance.usage_chart.cost'|trans }}',
                data: totals,
                backgroundColor: 'rgba(99, 102, 241, 0.6)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { maxRotation: 0 } },
                y: { beginAtZero: true, ticks: { precision: 2 } }
            }
        }
    });
})();
</script>
{% endif %}
{% endblock %}
